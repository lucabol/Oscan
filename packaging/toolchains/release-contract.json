{
  "schema_version": 1,
  "phase": "phase1",
  "install_surface": "github-releases",
  "toolchains_committed_to_git": false,
  "release_layout": {
    "binary_position": "archive-root",
    "toolchain_position": "archive-root/toolchain",
    "binary_and_toolchain_are_siblings": true
  },
  "native_backend": {
    "runtime_source_position": "archive-root/native-runtime",
    "runtime_archive_position_template": "archive-root/build/runtime-archives/{target}",
    "source_files": [
      "osc_native_shim.c",
      "osc_runtime.h"
    ]
  },
  "llvm_code_generator": {
    "role": "Oscan's own LLVM code generator for --backend llvm, loaded in-process. No clang/llvm-as/opt/llc subprocess and no installed LLVM SDK is ever used.",
    "required_major": 22,
    "declared_by": "the per-target toolchain manifest's toolchain.llvm_code_generator block",
    "position": "archive-root/toolchain",
    "search_roots": [
      "$OSCAN_LLVM_LIB (full path to the library)",
      "$OSCAN_LLVM_DIR",
      "$OSCAN_TOOLCHAIN_DIR",
      "<exe-dir>/toolchain",
      "<exe-dir>"
    ],
    "search_subdirectories": [
      "<root>/<platform>/bin",
      "<root>/<platform>/lib",
      "<root>/bin",
      "<root>/lib",
      "<root>"
    ],
    "search_names": {
      "windows": [
        "libLLVM-22.dll",
        "LLVM-C.dll",
        "libLLVM.dll"
      ],
      "linux": [
        "libLLVM.so.22.1",
        "libLLVM.so.22",
        "libLLVM-22.so",
        "libLLVM.so"
      ]
    },
    "never_searched": [
      "the current working directory",
      "PATH"
    ],
    "target_support": "gated on the initializers the packaged library actually exports (X86/AArch64/RISCV); a target the library cannot emit for is refused by name, never silently mis-emitted"
  },
  "lookup_contract": {
    "windows": {
      "search_roots": [
        "<exe-dir>\\toolchain",
        ".\\toolchain"
      ],
      "bin_directories": [
        "toolchain\\windows\\bin",
        "toolchain\\bin"
      ],
      "compiler_names": [
        "clang.exe",
        "gcc.exe",
        "cl.exe"
      ]
    },
    "linux": {
      "search_roots": [
        "<exe-dir>/toolchain",
        "./toolchain"
      ],
      "bin_directories": [
        "toolchain/linux/bin",
        "toolchain/bin"
      ],
      "compiler_names": [
        "clang",
        "gcc"
      ]
    }
  },
  "bundled_targets": {
    "windows-x86_64": {
      "binary_name": "oscan.exe",
      "bundle_kind": "full",
      "archive_format": "zip",
      "archive_name_template": "oscan-v{version}-windows-x86_64-full.zip",
      "archive_root_template": "oscan-v{version}-windows-x86_64-full",
      "toolchain_manifest": "windows-x86_64.json",
      "native_runtime_modes": [
        "hosted",
        "freestanding",
        "freestanding_gfx",
        "freestanding_core"
      ],
      "native_smoke_mode": "freestanding"
    },
    "linux-x86_64": {
      "binary_name": "oscan",
      "bundle_kind": "full",
      "archive_format": "tar.xz",
      "archive_name_template": "oscan-v{version}-linux-x86_64-full.tar.xz",
      "archive_root_template": "oscan-v{version}-linux-x86_64-full",
      "toolchain_manifest": "linux-x86_64.json",
      "native_runtime_modes": [
        "hosted",
        "freestanding",
        "freestanding_gfx",
        "freestanding_core"
      ],
      "native_smoke_mode": "freestanding"
    }
  },
  "binary_only_targets": {
    "macos-x86_64": {
      "binary_name": "oscan",
      "bundle_kind": "binary-only",
      "archive_format": "tar.gz",
      "archive_name_template": "oscan-v{version}-macos-x86_64.tar.gz",
      "archive_root_template": "oscan-v{version}-macos-x86_64",
      "requires_host_compiler": true,
      "required_host_toolchain": "apple-clt",
      "note_file": "macos-phase1-note.md",
      "native_runtime_modes": [],
      "native_smoke_mode": null
    }
  }
}
