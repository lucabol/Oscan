{
  "schema_version": 3,
  "install_surface": "github-releases",
  "toolchains_committed_to_git": false,
  "backends": {
    "llvm": {
      "cargo_feature": "backend-llvm",
      "kind": "object",
      "description": "Direct in-process LLVM object code. No C compiler, no C source, no toolchain."
    },
    "cranelift": {
      "cargo_feature": "backend-cranelift",
      "kind": "object",
      "description": "Cranelift object code. No C compiler, no C source, no toolchain. 'native' is only a deprecated CLI alias."
    },
    "c": {
      "cargo_feature": "backend-c",
      "kind": "c-source",
      "description": "Portability/reference backend: emits C and needs a C toolchain to compile it."
    }
  },
  "profiles": {
    "full": {
      "artifact_suffix": "full",
      "backends": [
        "llvm",
        "cranelift",
        "c"
      ],
      "default_backend": "llvm",
      "description": "All backends in one compiler. Select explicitly with --backend; LLVM is the deterministic default."
    },
    "llvm": {
      "artifact_suffix": "llvm",
      "backends": [
        "llvm"
      ],
      "default_backend": "llvm",
      "description": "Slim LLVM-only compiler."
    },
    "cranelift": {
      "artifact_suffix": "cranelift",
      "backends": [
        "cranelift"
      ],
      "default_backend": "cranelift",
      "description": "Slim Cranelift-only compiler."
    },
    "c": {
      "artifact_suffix": "c",
      "backends": [
        "c"
      ],
      "default_backend": "c",
      "description": "Slim C-only compiler."
    }
  },
  "components": {
    "compiler": {
      "position": "archive-root",
      "description": "The feature-gated oscan binary, stamped with OSCAN_DISTRIBUTION_PROFILE and OSCAN_DEFAULT_BACKEND."
    },
    "direct_link_sidecar": {
      "position": "archive-root/native-link",
      "manifest_name": "native-link-assets.json",
      "description": "Verified executable-relative native-link assets (linker, its sibling runtime libraries, import libraries, compiler builtins) preserving each asset's install_subpath.",
      "verified_by": "src/backend/native_assets/sidecar.rs"
    },
    "runtime_archives": {
      "position_template": "archive-root/build/runtime-archives/{target}",
      "description": "Precompiled runtime archives plus their manifests. Full packages include hosted and freestanding modes; slim object packages include freestanding modes only.",
      "allowed_profiles": [
        "hosted",
        "freestanding",
        "freestanding_gfx",
        "freestanding_core"
      ]
    },
    "llvm_provider": {
      "position": "archive-root/toolchain",
      "required_major": 22,
      "declared_by": "the per-target toolchain manifest's toolchain.llvm_code_generator block",
      "sources": [
        "direct-link-sidecar",
        "toolchain-manifest"
      ],
      "search_roots": [
        "$OSCAN_LLVM_LIB (full path to the library)",
        "$OSCAN_LLVM_DIR",
        "$OSCAN_TOOLCHAIN_DIR",
        "<exe-dir>/toolchain",
        "<exe-dir>/native-link",
        "<exe-dir>"
      ],
      "search_subdirectories": [
        "<root>/<platform>/bin",
        "<root>/<platform>/lib",
        "<root>/bin",
        "<root>/lib",
        "<root>"
      ],
      "search_names": {
        "windows": [
          "libLLVM-22.dll",
          "LLVM-C.dll",
          "libLLVM.dll"
        ],
        "linux": [
          "libLLVM.so.22.1",
          "libLLVM.so.22",
          "libLLVM-22.so",
          "libLLVM.so"
        ]
      },
      "never_searched": [
        "the current working directory",
        "PATH"
      ],
      "target_support": "gated on the initializers the packaged library actually exports (X86/AArch64/RISCV); a target the library cannot emit for is refused by name, never silently mis-emitted"
    },
    "c_toolchain": {
      "position": "archive-root/toolchain",
      "description": "The pinned, pruned C toolchain a package containing the C backend needs to compile emitted C."
    }
  },
  "lookup_contract": {
    "windows": {
      "search_roots": [
        "<exe-dir>\\toolchain",
        ".\\toolchain"
      ],
      "bin_directories": [
        "toolchain\\windows\\bin",
        "toolchain\\bin"
      ],
      "compiler_names": [
        "clang.exe",
        "gcc.exe",
        "cl.exe"
      ]
    },
    "linux": {
      "search_roots": [
        "<exe-dir>/toolchain",
        "./toolchain"
      ],
      "bin_directories": [
        "toolchain/linux/bin",
        "toolchain/bin"
      ],
      "compiler_names": [
        "clang",
        "gcc"
      ]
    }
  },
  "variants": {
    "windows-x86_64": {
      "binary_name": "oscan.exe",
      "archive_format": "zip",
      "toolchain_manifest": "windows-x86_64.json",
      "profiles": {
        "full": {
          "archive_name_template": "oscan-v{version}-windows-x86_64-full.zip",
          "archive_root_template": "oscan-v{version}-windows-x86_64-full",
          "msi_name_template": "oscan-v{version}-windows-x86_64-full.msi",
          "msi_product_name": "Oscan Full",
          "msi_upgrade_code": "2D90D756-5B6A-46EA-B70A-2AE1FBFF986D",
          "cargo_features": [
            "backend-llvm",
            "backend-cranelift",
            "backend-c",
            "inprocess-lld",
            "static-llvm"
          ],
          "rustflags": "-C target-feature=+crt-static",
          "toolchain_free": false,
          "link_mode": "inprocess",
          "components": [
            "compiler",
            "runtime_archives",
            "c_toolchain"
          ],
          "embedded_notice_files": [
            "LLVM-LICENSE.txt",
            "mingw-w64-COPYING.txt",
            "mingw-w64-project-COPYING.txt",
            "mingw-w64-runtime-COPYING.txt"
          ],
          "runtime_profiles": [
            "hosted",
            "freestanding",
            "freestanding_gfx",
            "freestanding_core"
          ]
        },
        "llvm": {
          "archive_name_template": "oscan-v{version}-windows-x86_64-llvm.zip",
          "archive_root_template": "oscan-v{version}-windows-x86_64-llvm",
          "msi_name_template": "oscan-v{version}-windows-x86_64-llvm.msi",
          "msi_product_name": "Oscan LLVM",
          "msi_upgrade_code": "F7A3B2C1-4D5E-6F78-9A0B-1C2D3E4F5A6B",
          "cargo_features": [
            "backend-llvm",
            "inprocess-lld",
            "static-llvm"
          ],
          "rustflags": "-C target-feature=+crt-static",
          "toolchain_free": true,
          "link_mode": "inprocess",
          "components": [
            "compiler"
          ],
          "embedded_notice_files": [
            "LLVM-LICENSE.txt",
            "mingw-w64-COPYING.txt",
            "mingw-w64-project-COPYING.txt",
            "mingw-w64-runtime-COPYING.txt"
          ],
          "runtime_profiles": [
            "freestanding",
            "freestanding_gfx",
            "freestanding_core"
          ]
        },
        "cranelift": {
          "archive_name_template": "oscan-v{version}-windows-x86_64-cranelift.zip",
          "archive_root_template": "oscan-v{version}-windows-x86_64-cranelift",
          "msi_name_template": "oscan-v{version}-windows-x86_64-cranelift.msi",
          "msi_product_name": "Oscan Cranelift",
          "msi_upgrade_code": "F3F0AE9A-0CBC-48EC-8CE3-6E2962F0DD7A",
          "cargo_features": [
            "backend-cranelift"
          ],
          "toolchain_free": true,
          "link_mode": "sidecar",
          "components": [
            "compiler",
            "direct_link_sidecar",
            "runtime_archives"
          ],
          "runtime_profiles": [
            "freestanding",
            "freestanding_gfx",
            "freestanding_core"
          ]
        },
        "c": {
          "archive_name_template": "oscan-v{version}-windows-x86_64-c.zip",
          "archive_root_template": "oscan-v{version}-windows-x86_64-c",
          "msi_name_template": "oscan-v{version}-windows-x86_64-c.msi",
          "msi_product_name": "Oscan C",
          "msi_upgrade_code": "F9A6AE6D-5718-482F-9D3B-780F8CCB062F",
          "cargo_features": [
            "backend-c"
          ],
          "toolchain_free": false,
          "components": [
            "compiler",
            "c_toolchain"
          ],
          "runtime_profiles": []
        }
      }
    },
    "linux-x86_64": {
      "binary_name": "oscan",
      "archive_format": "tar.xz",
      "toolchain_manifest": "linux-x86_64.json",
      "profiles": {
        "full": {
          "archive_name_template": "oscan-v{version}-linux-x86_64-full.tar.xz",
          "archive_root_template": "oscan-v{version}-linux-x86_64-full",
          "cargo_features": [
            "backend-llvm",
            "backend-cranelift",
            "backend-c"
          ],
          "toolchain_free": false,
          "link_mode": "sidecar",
          "components": [
            "compiler",
            "direct_link_sidecar",
            "runtime_archives",
            "llvm_provider",
            "c_toolchain"
          ],
          "llvm_provider_source": "toolchain-manifest",
          "runtime_profiles": [
            "hosted",
            "freestanding",
            "freestanding_gfx",
            "freestanding_core"
          ]
        },
        "llvm": {
          "archive_name_template": "oscan-v{version}-linux-x86_64-llvm.tar.xz",
          "archive_root_template": "oscan-v{version}-linux-x86_64-llvm",
          "cargo_features": [
            "backend-llvm"
          ],
          "toolchain_free": true,
          "link_mode": "sidecar",
          "components": [
            "compiler",
            "direct_link_sidecar",
            "runtime_archives",
            "llvm_provider"
          ],
          "llvm_provider_source": "toolchain-manifest",
          "runtime_profiles": [
            "freestanding",
            "freestanding_gfx",
            "freestanding_core"
          ]
        },
        "cranelift": {
          "archive_name_template": "oscan-v{version}-linux-x86_64-cranelift.tar.xz",
          "archive_root_template": "oscan-v{version}-linux-x86_64-cranelift",
          "cargo_features": [
            "backend-cranelift"
          ],
          "toolchain_free": true,
          "link_mode": "sidecar",
          "components": [
            "compiler",
            "direct_link_sidecar",
            "runtime_archives"
          ],
          "runtime_profiles": [
            "freestanding",
            "freestanding_gfx",
            "freestanding_core"
          ]
        },
        "c": {
          "archive_name_template": "oscan-v{version}-linux-x86_64-c.tar.xz",
          "archive_root_template": "oscan-v{version}-linux-x86_64-c",
          "cargo_features": [
            "backend-c"
          ],
          "toolchain_free": false,
          "components": [
            "compiler",
            "c_toolchain"
          ],
          "runtime_profiles": []
        }
      }
    },
    "macos-x86_64": {
      "binary_name": "oscan",
      "archive_format": "tar.gz",
      "note_file": "macos-phase1-note.md",
      "profiles": {
        "c": {
          "archive_name_template": "oscan-v{version}-macos-x86_64-c.tar.gz",
          "archive_root_template": "oscan-v{version}-macos-x86_64-c",
          "cargo_features": [
            "backend-c"
          ],
          "toolchain_free": false,
          "components": [
            "compiler"
          ],
          "requires_host_compiler": true,
          "required_host_toolchain": "apple-clt",
          "runtime_profiles": []
        }
      }
    }
  }
}
