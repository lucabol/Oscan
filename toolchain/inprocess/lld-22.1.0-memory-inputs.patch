--- /dev/null
+++ b/lld/include/lld/COFF/MemoryInput.h
@@ -0,0 +1,31 @@
+//===- MemoryInput.h - Borrowed in-memory COFF inputs ------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLD_COFF_MEMORY_INPUT_H
+#define LLD_COFF_MEMORY_INPUT_H
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/StringRef.h"
+#include <cstdint>
+
+namespace lld::coff {
+
+struct MemoryInput {
+  llvm::StringRef name;
+  llvm::ArrayRef<uint8_t> data;
+};
+
+// Inputs are borrowed and must remain alive until lldMain returns. The caller
+// must serialize calls because this registry deliberately outlives the MinGW
+// driver context that is destroyed before dispatching to the COFF driver.
+void setMemoryInputs(llvm::ArrayRef<MemoryInput> inputs);
+void clearMemoryInputs();
+
+} // namespace lld::coff
+
+#endif
