+static StringMap<ArrayRef<uint8_t>> memoryInputs;
+
+void setMemoryInputs(ArrayRef<MemoryInput> inputs) {
+  memoryInputs.clear();
+  for (const MemoryInput &input : inputs)
+    memoryInputs[input.name] = input.data;
+}
+
+void clearMemoryInputs() { memoryInputs.clear(); }
+
+static std::optional<ArrayRef<uint8_t>> findMemoryInput(StringRef path) {
+  auto input = memoryInputs.find(path);
+  if (input == memoryInputs.end())
+    return std::nullopt;
+  return input->second;
+}
